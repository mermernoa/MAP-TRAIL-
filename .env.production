# Ne jamais mettre ici la clé secrète.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Adresse de contact affichée sur le site et utilisée par les formulaires
# (contact, signaler une erreur, proposer une course) si Supabase n'est pas configuré.
